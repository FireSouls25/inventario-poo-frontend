{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://inventario-poo-backend.onrender.com/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
